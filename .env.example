# Clyvro environment configuration.
# No variables are REQUIRED locally — the app runs with safe defaults.
# Never commit real credentials.

# Public origin used for sitemap.xml, robots.txt and Open Graph URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Database & auth ---
# Postgres connection string (Neon POOLED url in production). When unset,
# an embedded PGlite database under .data/ is used (zero-config local dev,
# same schema/migrations). Production must set this (Neon).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Auth.js session secret. REQUIRED in production. Generate: openssl rand -base64 32
# AUTH_SECRET=
# Tests only: keep the embedded database in memory.
# CLYVRO_DB_MEMORY=1

# --- Firebase Authentication — Google sign-in via Firebase ---
# Founder-owned Firebase project (Neon Auth retired; Neon is DB-only now).
# Firebase Console → Authentication → Sign-in method → Google → Enable,
# and Settings → Authorized domains must include the production domain
# (clyvro.vercel.app) + localhost. Then copy the web app config here —
# these NEXT_PUBLIC_* values are public by design (they identify the
# Firebase app in browsers; security comes from server-side token
# verification + Firebase rules, not from hiding them).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_APP_ID=1:...:web:...
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Server anchor for ID-token verification (aud/iss). Optional when
# NEXT_PUBLIC_FIREBASE_PROJECT_ID is set (it falls back to that).
# FIREBASE_PROJECT_ID=
# Legacy/alternative: direct Google provider on Auth.js (either this OR
# Firebase can serve Google; Firebase is the preferred path).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Dispatcher / cron ---
# Bearer secret for /api/cron/dispatch and authenticated /api/cron/health
# diagnostics. Vercel Cron sends it automatically from this variable.
# Outside schedulers (cron-job.org) should call the public, secret-free
# /api/cron/tick instead — never paste this value into a third party.
# Generate: openssl rand -hex 32. Already set in Vercel Production.
# CRON_SECRET=

# --- Security (Clyvro Shield) ---
# No keys needed: the edge↔Node token is derived from AUTH_SECRET and the
# mode (monitor/enforce/under-attack) lives in Admin → Security.
# Public contact shown on /security and the blocked page (security.txt is static).
# SECURITY_CONTACT_EMAIL=admin.founda@gmail.com

# --- Billing (Flutterwave) ---
# Checkout stays honestly "not switched on" until these exist.
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=   # the "secret hash" from the Flutterwave dashboard
# FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3
# Payment region verification: checkout refuses VPN/proxy connections and
# billing-country/connection-region mismatches. Country comes from the
# platform geo header (x-vercel-ip-country) by default; set an IP-intel
# endpoint ({ip} placeholder) to also discard VPN/proxy/Tor connections.
# PAYMENT_IP_INTEL_URL=https://ip-api.com/json/{ip}?fields=status,countryCode,proxy,hosting
# PAYMENT_IP_INTEL_KEY=

# --- Email (SMTP — password resets, notifications, waitlist, invites) ---
# SMTP_URL=smtp://user:pass@host:587
# — or — SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / SMTP_SECURE=1
# EMAIL_FROM="Clyvro <no-reply@your-domain>"
# Where waitlist notifications are sent (defaults to the owner email).
# WAITLIST_NOTIFY_EMAIL=

# --- Platform owner & admins (server-only; never rendered on the site) ---
# Owner workspaces get Ultra Agency for life (no expiry, never degraded)
# and the listed emails get /admin (Admin Control Center) access.
# CLYVRO_OWNER_EMAILS=legateakanjimusab@gmail.com
# CLYVRO_ADMIN_EMAILS=legateakanjimusab@gmail.com

# --- Scanner tuning (optional; shown values are defaults) ---
# SCAN_MAX_PAGES=10            # public-scan pages (1-25)
# SCAN_MAX_LINK_CHECKS=20      # public-scan link checks (0-40)
# SCAN_REQUEST_TIMEOUT_MS=8000 # per request (1000-20000)
# SCAN_DEADLINE_MS=45000       # per worker slice (5000-55000)
# SCAN_JOB_MAX_DURATION_MS=7200000  # absolute per-scan cap → timed_out
# SCAN_CHECKPOINT_LIFETIME_MS=86400000
# SCAN_SLICE_WORK_BUDGET=8     # base slice budget (deep mode uses 40)

# --- Misc ---
# Local development ONLY: pretend every workspace is on this plan. Ignored in production.
# CLYVRO_DEV_PLAN=pro
# Free anonymous checks per network+device before sign-up (default 1; 0 = unlimited locally).
# CLYVRO_PUBLIC_SCAN_LIMIT=1
# PAGESPEED_API_KEY=           # optional, future performance rules

# --- Backups (Cloudflare R2, S3-compatible) ---
# Workspace/platform backups stay honestly "not configured" until these
# exist. Create a bucket + API token in Cloudflare → R2. Server-only.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clyvro-backups

# --- Flow Scan browser (Playwright) ---
# Preferred: run the browser EXTERNALLY so scan orchestration stays
# light on the host — paste the full WebSocket endpoint from your
# browser provider (e.g. Browserless: wss://production-sfo.browserless.io/?token=...).
# When unset, the bundled serverless Chromium is used instead.
# PLAYWRIGHT_WS_ENDPOINT=

# --- Code Reviewer GitHub bot (GitHub App) ---
# Until all four are set, the Code Reviewer page honestly says the bot
# isn't switched on (the paste checker still works). Founder steps:
#   GitHub → Settings → Developer settings → GitHub Apps → New GitHub App
#   • Name: Clyvro Code Reviewer (the slug becomes GITHUB_APP_SLUG)
#   • Homepage URL: https://clyvro.vercel.app
#   • Webhook URL: https://clyvro.vercel.app/api/github/webhook
#     Webhook secret: generate one → GITHUB_APP_WEBHOOK_SECRET
#   • Setup URL: https://clyvro.vercel.app/app/code-reviewer/github-setup
#     (tick "Redirect on update" OFF; users land there after install)
#   • Repository permissions: Contents = Read-only, Metadata = Read-only
#   • Subscribe to events: Push (install/uninstall are automatic)
#   • Generate a private key (.pem) → GITHUB_APP_PRIVATE_KEY (paste the
#     whole PEM; literal \n line breaks are accepted)
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
