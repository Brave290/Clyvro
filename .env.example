# Clyvro environment configuration.
# No variables are REQUIRED — the app runs with safe defaults.

# Public origin used for sitemap.xml, robots.txt and Open Graph URLs.
# Set this in production, e.g. NEXT_PUBLIC_SITE_URL=https://your-domain.example
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 scanner tuning (all optional; shown values are the defaults) ---
# Pages fully fetched and parsed per scan (1-25)
# SCAN_MAX_PAGES=10
# Extra same-origin URLs verified with headers-only requests (0-40)
# SCAN_MAX_LINK_CHECKS=20
# Per-request timeout in milliseconds (1000-20000)
# SCAN_REQUEST_TIMEOUT_MS=8000
# Hard wall-clock budget per scan in milliseconds (5000-55000)
# SCAN_DEADLINE_MS=45000

# --- Phase 3: database & auth ---
# Postgres connection string (Neon pooled URL in production). When unset,
# the app uses an embedded PGlite database under .data/ — zero-config local
# development with the SAME schema/migrations.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Auth.js session secret. REQUIRED in production; a dev-only fallback is
# used locally. Generate: openssl rand -base64 32
# AUTH_SECRET=
# Tests only: keep the embedded database in memory.
# CLYVRO_DB_MEMORY=1
# Local development ONLY: pretend every workspace is on this plan so higher
# entitlements can be exercised before billing exists. Ignored in production.
# CLYVRO_DEV_PLAN=pro
# Free anonymous checks allowed per network+device before sign-up is
# required (default 1; 0 = unlimited, handy for local development).
# CLYVRO_PUBLIC_SCAN_LIMIT=1

# --- Later phases (see docs/ROADMAP.md) ---
# PAGESPEED_API_KEY=       # Google PageSpeed Insights (performance rules)
# Payment provider keys    # Phase 6 only; no billing exists yet
